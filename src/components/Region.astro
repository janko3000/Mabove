---
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<div class="border-t border-line py-8">
  <div class="page storey-grid">
    <p class="text-ink-muted lg:col-start-2">{dict.region.text}</p>
  </div>
</div>
