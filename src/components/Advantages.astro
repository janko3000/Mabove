---
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="storey" aria-labelledby="warum-title">
  <div class="page storey-grid">
    <h2 id="warum-title" class="storey-title">{dict.advantages.title}</h2>

    <div class="floors measure">
      {
        dict.advantages.items.map((item) => (
          <div>
            <h3 class="text-[1.25rem] leading-snug">{item.title}</h3>
            <p class="mt-2">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
