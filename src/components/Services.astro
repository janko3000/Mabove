---
import { t, anchors, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const id = anchors[locale].services;
---

<section id={id} class="storey" aria-labelledby={`${id}-title`}>
  <div class="page storey-grid">
    <h2 id={`${id}-title`} class="storey-title">{dict.services.title}</h2>

    <div class="grid gap-12 md:grid-cols-3 md:gap-8">
      {
        dict.services.items.map((item) => (
          <article>
            <h3 class="text-[1.25rem] leading-snug">{item.title}</h3>
            <p class="mt-2 mb-5">{item.text}</p>
            <ul class="ledger" aria-label={`${dict.services.keywordsLabel}: ${item.title}`}>
              {item.keywords.map((keyword) => (
                <li>{keyword}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
