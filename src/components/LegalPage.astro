---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  page: 'imprint' | 'privacy';
}

const { locale, page } = Astro.props;
const content = t(locale)[page];
---

<BaseLayout locale={locale} page={page} title={content.metaTitle} description={content.metaDescription}>
  <article class="page py-14 lg:py-20">
    <div class="measure">
      <h1 class="accent-line text-[2.25rem] leading-[1.15]">{content.title}</h1>
      <p class="mt-4 field-hint">{content.draftNote}</p>

      {
        content.sections.map((section) => (
          <section class="mt-10">
            <h2 class="text-[1.25rem] leading-snug">{section.heading}</h2>
            {section.paragraphs.map((paragraph, i) => (
              <p class={i === 0 ? 'mt-2' : 'mt-1'}>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>
